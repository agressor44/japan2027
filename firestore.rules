rules_version = '2';

// Japan 2027 - the whole plan is one document, readable and writable
// only by the people on the trip.
//
// To add someone: put their Google account email in the list below and
// redeploy the rules. Emails are compared lowercase.

service cloud.firestore {
  match /databases/{database}/documents {

    function crew() {
      return [
        'adam.kraus44@gmail.com',
        'cidi6@hotmail.com'
      ];
    }

    function isCrew() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in crew();
    }

    match /plan/{doc} {
      allow read, write: if isCrew();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
